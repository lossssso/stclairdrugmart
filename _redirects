# Cloudflare Pages redirects
# 301s for the 7 neighbourhood pages removed in July 2026 (thin/doorway
# cleanup). Sends visitors and link equity to the homepage and lets
# Google clear the "Not found (404)" rows faster than waiting for the
# URLs to age out. The two-line pairs cover slash and no-slash forms.
/pharmacy-corso-italia / 301
/pharmacy-corso-italia/* / 301
/pharmacy-davenport / 301
/pharmacy-davenport/* / 301
/pharmacy-dupont / 301
/pharmacy-dupont/* / 301
/pharmacy-hillcrest-humewood / 301
/pharmacy-hillcrest-humewood/* / 301
/pharmacy-oakwood-village / 301
/pharmacy-oakwood-village/* / 301
/pharmacy-regal-heights / 301
/pharmacy-regal-heights/* / 301
/pharmacy-wychwood / 301
/pharmacy-wychwood/* / 301

# 301s for ghost URLs Google keeps crawling (GSC "Not found (404)" and
# "Crawled - currently not indexed", Aug 2026). Never pages on this site's
# current build; likely legacy links. Ailment names go to the portal
# (assessment entry), everything else to the homepage.
/head-lice /portal/ 301
/impetigo /portal/ 301
/home / 301
/book-appointment /portal/ 301
/book-appointment/* /portal/ 301

# Legacy URL catchers, previously tiny noindexed HTML stub pages that
# JS-redirected. Now proper 301s (and the stub files are deleted).
# /portal without the trailing slash used to serve the stale portal.html
# stub; the explicit rule sends it to the real portal page.
/contact /#contact 301
/contact/* /#contact 301
/find-us /#contact 301
/find-us/* /#contact 301
/portal.html /portal/ 301
/portal /portal/ 301
